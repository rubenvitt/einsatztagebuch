{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.einsatzarchiv.de/payload/v1/amendment.schema.json",
  "title": "Einsatzarchiv Amendment Payload v1 Logical Projection",
  "type": "object",
  "properties": {
    "recordType": { "const": "amendment" },
    "recordId": { "$ref": "#/$defs/id16" },
    "schemaId": { "const": "ea.amendment" },
    "schemaVersion": { "const": 1 },
    "finalizedAtDevice": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
    "timezone": { "type": "string", "minLength": 1 },
    "operator": { "$ref": "#/$defs/operator" },
    "source": { "$ref": "#/$defs/source" },
    "registryVersion": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "extensionData": { "type": "array", "maxItems": 0 },
    "body": {
      "type": "object",
      "properties": {
        "originalIncidentNumber": { "type": "string", "minLength": 1, "maxLength": 64 },
        "originalRecordId": { "$ref": "#/$defs/id16" },
        "originalEntryHash": { "$ref": "#/$defs/hash32" },
        "originalSequence": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "reason": { "type": "string", "minLength": 1 },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "fieldPath": { "type": "string", "minLength": 1 },
              "changeText": { "type": "string", "minLength": 1 }
            },
            "required": ["fieldPath", "changeText"],
            "additionalProperties": false
          }
        }
      },
      "required": ["originalIncidentNumber", "originalRecordId", "originalEntryHash", "originalSequence", "reason", "changes"],
      "additionalProperties": false
    }
  },
  "required": ["recordType", "recordId", "schemaId", "schemaVersion", "finalizedAtDevice", "timezone", "operator", "source", "registryVersion", "extensionData", "body"],
  "additionalProperties": false,
  "$defs": {
    "id16": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "hash32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operator": {
      "type": "object",
      "properties": {
        "organizationId": { "$ref": "#/$defs/id16" },
        "operatorSubjectId": { "$ref": "#/$defs/id16" },
        "displayName": { "type": "string" },
        "functionLabel": { "type": "string" },
        "salt": { "$ref": "#/$defs/hash32" },
        "operatorBindingObjectHash": { "$ref": "#/$defs/hash32" }
      },
      "required": ["organizationId", "operatorSubjectId", "displayName", "functionLabel", "salt", "operatorBindingObjectHash"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": { "const": "native" },
        "sourceId": { "type": "string" },
        "sourceFormatVersion": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      },
      "required": ["kind", "sourceId", "sourceFormatVersion"],
      "additionalProperties": false
    }
  }
}
