; Einsatzarchiv v0.1 sync protocol: schreibende Rahmen und Fehlerkoerper.
; Bestandteil des Sync-Wire-Addendums und normativ.
;
; Symbolische Namen dokumentieren Arraypositionen; sie werden nicht als
; CBOR-Map-Keys serialisiert. Alle Objekte sind deterministisch nach Design
; §10.1 kodiert. Die letzte Position jedes Rahmens ist ein leeres Array als
; geschlossener Erweiterungsplatz.
;
; challenge-response-core-v1, challenge-response-v1,
; device-registration-request-core-v1, device-registration-request-v1,
; reader-ack-core-v1 und reader-ack-v1 werden unveraendert aus
; schemas/protocol/v1/signed-protocol.cddl uebernommen und hier nicht wiederholt.

; Der initiale Grant-Plan in genau der Form, die encode_plan_items in
; crates/ea-format/src/eag.rs erzeugt: ein Array aus Vierertupeln mit dem
; 32-Byte-Empfaengerschluessel-Thumbprint, dem 32-Byte-Empfaengerzertifikatshash,
; der Suite-Zeichenkette und dem Ein-Byte-Zweck (0 Recovery, 1 Reader). Der
; initialGrantPlanHash steht ueber genau diesen Bytes.
grant-plan-item-v1 = [
  recipient-key-thumbprint: bstr .size 32,
  recipient-certificate-hash: bstr .size 32,
  "EINSATZARCHIV-HPKE-1", grant-purpose: 0..1
]
grant-plan-v1 = [* grant-plan-item-v1]

entry-commit-request-v1 = [
  1, entry-bytes: bstr, grant-plan: grant-plan-v1,
  initial-grant-bytes: [+ bstr], []
]

entry-commit-response-v1 = [
  1, outcome: 0..1, ; 0 accepted, 1 idempotent replay
  receipt-bytes: bstr, checkpoint-bytes: bstr / null, []
]

; Die beiden UNSIGNIERTEN Aufnahmerahmen. openapi.yaml nennt fuer beide nur
; den Medientyp und ein leeres Schema; ihre Produktionen stehen deshalb hier.
; challenge-request-v1 traegt die organization-id, weil der Challenge-Endpunkt
; die eine Signaturausnahme ohne tag-Parameter ist, challenge-response-core-v1
; die Organisation aber an Position 2 fuehrt. Sie ist zugleich die
; nicht-inhaltliche technische Identitaet der Ratenbegrenzung.
challenge-request-v1 = [1, organization-id: bstr .size 16, []]

; Die pseudonyme subject-id IST der userHandle (web-reader-design.md §6.4.1).
; Der Rahmen traegt keinen Anzeigenamen und keinen fachlichen Wert.
; credential-public-cose-key ist die KANONISCHE COSE-Karte dieses
; Arbeitsbereichs, {1: 1 (OKP), -1: 6 (Ed25519), -2: x}, und darin genau der
; Ed25519-Arm: §6.4.1 nennt keinen Algorithmus, die Suite ist durchgehend
; Ed25519 (Design §13.1, alg="ed25519"), und die spaetere Assertion muss gegen
; genau diesen Schluessel tragen.
webauthn-credential-registration-v1 = [
  1, subject-id: bstr .size 16,
  credential-id: bstr .size (16..1023),
  credential-public-cose-key: bstr, []
]

; Die drei Rahmen der Vault-Blob-Flaeche (web-reader-design.md §6.4/§6.4.1).
; openapi.yaml nennt fuer beide Endpunkte nur den Medientyp und ein leeres
; Schema; ihre Produktionen stehen deshalb hier.
;
; vault-blob-upload-v1 traegt KEINEN Blobhash: der Server rechnet ihn als
; SHA-256 ueber die exakten Chiffratbytes und schreibt create-if-absent ueber
; (organization-id, subject-id, Blobhash). Ein behaupteter Hash waere eine
; Adresse, die nicht auf ihren Inhalt zeigen muss. Die organization-id steht
; ebenfalls nicht im Rahmen: sie kommt aus der geprueften RFC-9421-Identitaet
; des Aufrufers. Die subject-id darf der Aufrufer waehlen, die Organisation
; nicht.
vault-blob-upload-v1 = [1, subject-id: bstr .size 16, ciphertext: bstr .size (1..4096), []]

; Der Abruf ist die ZWEITE und letzte Signaturausnahme (Design §13.1,
; Reader-Vorbehalt), traegt deshalb wie challenge-request-v1 die
; organization-id — die Credentialaufloesung laeuft ueber den
; Eindeutigkeitszwang (organization-id, credential-id) — und stellt die
; subject-id nur als BEHAUPTUNG: der Server prueft sie gegen den userHandle des
; aufgeloesten Credentials. Die client-data-json steht auf dem Draht, weil die
; Assertion ueber genau diese Bytes signiert; der Server PARST sie nicht,
; sondern serialisiert die erwartete CollectedClientData aus challenge und
; Bundle-Origin und vergleicht byteweise (ADR 0004: kein zweiter Dekodierweg).
vault-blob-retrieval-request-v1 = [
  1, organization-id: bstr .size 16, subject-id: bstr .size 16,
  credential-id: bstr .size (16..1023),
  challenge: bstr .size 32,
  authenticator-data: bstr .size (37..1024),
  client-data-json: bstr .size (1..2048),
  signature: bstr .size 64, []
]

; Die opaken Chiffrate genau einer subject-id. Kein Blobhash, kein
; Zeitstempel, keine Zaehlung: alles Weitere waere ein Servermetadatum ueber
; einen Bestand, den der Server nicht lesen kann.
vault-blob-retrieval-response-v1 = [1, ciphertexts: [* bstr .size (1..4096)], []]

trust-event-upload-v1 = [1, exact-etb-bytes: bstr, []]

historical-grant-upload-v1 = [1, exact-eag-bytes: bstr, []]

destruction-request-v1 = [1, exact-destruction-authorization-etb-bytes: bstr, []]

; Der einzige Fehlerkoerper des Protokolls. request-id ist global eindeutig und
; bleibt an dieser Position; sie ist die einzige Stelle, an der sich zwei
; Antworten auf denselben Befund unterscheiden duerfen.
protocol-error-v1 = [
  1, error-code: tstr, request-id: bstr .size 16,
  retryable: bool, required-registry-version: uint / null,
  required-registry-head-hash: (bstr .size 32) / null, []
]
