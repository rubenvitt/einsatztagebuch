<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="NativeReadOnly/**/*.cs" />
    <Compile Include="../src/Protocol.cs" Link="Protocol.cs" />
    <Compile Include="../src/Crypto.cs" Link="Crypto.cs" />
    <Compile Include="../src/Win32.cs" Link="Win32.cs" />
    <Compile Include="../src/ConsoleLine.cs" Link="ConsoleLine.cs" />
    <Compile Include="../src/WatchLifetime.cs" Link="WatchLifetime.cs" />
    <Compile Include="../src/WatchChallenges.cs" Link="WatchChallenges.cs" />
    <PackageReference Include="NSec.Cryptography" Version="[26.4.0]" />
  </ItemGroup>
</Project>
