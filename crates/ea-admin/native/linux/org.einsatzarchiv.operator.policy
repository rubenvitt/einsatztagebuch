<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Einsatzarchiv</vendor>
  <action id="org.einsatzarchiv.operator.authenticate">
    <description>Authenticate the current Einsatzarchiv operator</description>
    <description xml:lang="de">Aktuelles Einsatzarchiv-Konto bestätigen</description>
    <message>Authenticate with your own account to approve this Einsatzarchiv operation.</message>
    <message xml:lang="de">Bestätigen Sie diesen Einsatzarchiv-Vorgang mit Ihrem eigenen Konto.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
