{
  "productName": "Einsatzarchiv",
  "version": "0.1.0",
  "identifier": "de.einsatzarchiv.writer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Einsatzarchiv — Writer",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "default",
        {
          "identifier": "ea-writer-commands",
          "description": "Die VOLLSTAENDIGE Erlaubnisliste der Kommandos dieses Pakets. Sie wirkt, weil build.rs ein App-ACL-Manifest erklaert: dann verlangt tauri fuer JEDES Kommando eine aufgeloeste Erlaubnis, und eine Erlaubnis ohne Kommando laesst generate_context! mit UnknownPermission abbrechen. Kein Name hier bedient das Entschluesseln, den Verlauf oder den Inhalt eines abgeschlossenen Eintrags. Die admin-Kommandos (Stufe 5, DRK-274) sind im Wirt auf die Rolle OrganizationAdmin gebunden; die ACL erlaubt sie dem Fenster, das Rollentor entscheidet je Aufruf.",
          "local": true,
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-verified-session",
            "allow-session-login",
            "allow-invalidate-session-on-lock",
            "allow-startup-recovery",
            "allow-master-data-counts",
            "allow-session-reauthenticate",
            "allow-master-data-search",
            "allow-draft-load-active",
            "allow-draft-save",
            "allow-draft-discard-begin",
            "allow-draft-discard-resume",
            "allow-writer-recover-pending",
            "allow-writer-amendment-import",
            "allow-draft-save-amendment",
            "allow-writer-preview-amendment",
            "allow-writer-finalize-amendment",
            "allow-writer-acknowledge-stale-amendment",
            "allow-writer-preview",
            "allow-writer-acknowledge-stale-registry",
            "allow-writer-finalize",
            "allow-archive-health-report",
            "allow-device-posture-report",
            "allow-archive-export-bundle-file",
          "allow-destruction-read",
          "allow-destruction-prepare",
          "allow-destruction-start",
          "allow-destruction-resume",
          "allow-destruction-import-progress",
          "allow-destruction-export-reader-delivery",
          "allow-destruction-synchronize",
          "allow-destruction-authenticate-custodian",
          "allow-destruction-evidence-preview",
          "allow-destruction-evidence-finalize",
          "allow-destruction-evidence-recover",
          "allow-destruction-evidence-discard",
          "allow-recovery-read",
          "allow-recovery-start",
          "allow-recovery-submit",
          "allow-recovery-cancel",
          "allow-sync-state",
            "allow-admin-pending-device-requests",
          "allow-admin-open-ceremonies",
          "allow-admin-ceremony-begin",
          "allow-admin-ceremony-read",
            "allow-admin-ceremony-confirm-fingerprint",
            "allow-admin-ceremony-authorize",
            "allow-admin-ceremony-export-request",
            "allow-admin-ceremony-import-reply",
            "allow-admin-ceremony-publish",
            "allow-admin-policy-profile",
            "allow-admin-registry-health",
            "allow-admin-writer-lock-diagnosis",
            "allow-admin-go-live-checklist",
            "allow-admin-go-live-export-unresolved",
            "allow-admin-clock-release-offer",
            "allow-admin-clock-release-issue",
            "allow-admin-writer-transition-state",
            "allow-admin-writer-transition-prepare",
            "allow-admin-writer-transition-activate",
            "allow-admin-revocation-effect"
          ]
        }
      ]
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.png"
    ]
  }
}
